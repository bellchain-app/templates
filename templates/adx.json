    "description": {
      "de": "Der ADX steigt über 25: ▲ wenn +DI vorn liegt, ▼ wenn −DI vorn liegt.",
      "en": "The ADX rises above 25: ▲ when +DI leads, ▼ when −DI leads."
    },
    "tags": [
      "trend"
    ],
    "author": "Bellchain",
    "notes": {
      "n1": {
        "de": "Idee: Der ADX misst, wie stark ein Trend ist, nicht seine Richtung. Steigt er über 25, beginnt ein deutlicher Trend; ob er nach oben oder unten zeigt, sagen +DI und −DI.",
        "en": "Idea: the ADX measures how strong a trend is, not its direction. When it rises above 25, a clear trend begins; +DI and −DI tell whether it points up or down."
      }
    },
    "messages": {
      "t1": {
        "de": "▲ {{coin}}: starker Trend nach oben · {{werte}}",
        "en": "▲ {{coin}}: strong trend up · {{values}}"
      },
      "t2": {
        "de": "▼ {{coin}}: starker Trend nach unten · {{werte}}",
        "en": "▼ {{coin}}: strong trend down · {{values}}"
      }
    },
    "tips": [
      {
        "de": "Schwelle 30 meldet erst kräftigere Trends.",
        "en": "A threshold of 30 only reports stronger trends."
      },
      {
        "de": "Mit 4-Stunden-Kerzen zeigt der ADX die großen Trends.",
        "en": "With 4-hour candles the ADX shows the big trends."
      }
    ],
    "test": {
      "alerts": 29,
      "days": 90,
      "until": "2026-10-17"
    }
  },
  "nodes": [
