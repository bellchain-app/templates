    "description": {
      "de": "Mindestens drei von vier Signalen melden „überverkauft“: RSI, Stoch RSI, Bollinger-Band und MFI.",
      "en": "At least three of four signals report “oversold”: RSI, Stoch RSI, Bollinger Band and MFI."
    },
    "tags": [
      "konfluenz",
      "dip"
    ],
    "author": "Bellchain",
    "notes": {
      "n1": {
        "de": "Idee: Ein Signal allein irrt oft, mehrere zusammen seltener. „Mindestens X von N“ zählt, wie viele Bedingungen gerade zutreffen, und meldet sich ab drei. So muss nicht alles gleichzeitig passen.",
        "en": "Idea: one signal alone is often wrong, several together less often. “At least X of N” counts how many conditions are true right now and alerts from three. So not everything has to match at once."
      }
    },
    "messages": {
      "p1": {
        "de": "{{coin}}: 3 von 4 Signalen überverkauft · {{werte}}",
        "en": "{{coin}}: 3 of 4 signals oversold · {{values}}"
      },
      "t1": {
        "de": "{{coin}}: 3 von 4 Signalen überverkauft · {{werte}}",
        "en": "{{coin}}: 3 of 4 signals oversold · {{values}}"
      }
    },
    "tips": [
      {
        "de": "Mit 2 statt 3 kommen deutlich mehr Alarme.",
        "en": "With 2 instead of 3 you get many more alerts."
      },
      {
        "de": "Weitere Bedingungen hängst du an die freien Eingänge, bis zu acht.",
        "en": "Connect further conditions to the free inputs, up to eight."
      }
    ],
    "test": {
      "alerts": 18,
      "days": 90,
      "until": "2026-10-17"
    }
  },
